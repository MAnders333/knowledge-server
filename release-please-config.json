      "section": "Bug Fixes"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "docs",
      "section": "Documentation"
    }
  ]
}
