{
	"name": "knowledge-server",
	"version": "3.12.0",
	"description": "A consolidation-aware knowledge system that distills episodic memory from OpenCode sessions into retrievable knowledge, with embedding-based associative activation.",
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"consolidate": "bun run src/index.ts consolidate",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit",
		"compile": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig",
		"build": "bun run compile src/index.ts --outfile dist/knowledge-server && bun run compile src/daemon/index.ts --outfile dist/knowledge-daemon",
		"build:server": "bun run compile src/index.ts --outfile dist/knowledge-server",
		"build:daemon": "bun run compile src/daemon/index.ts --outfile dist/knowledge-daemon",
		"setup": "bash scripts/setup.sh",
		"lint": "bunx biome check src/ tests/ plugin/ bench/ scripts/",
		"format": "bunx biome format --write src/ tests/ plugin/ bench/ scripts/"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.142",
		"@ai-sdk/google": "^3.0.146",
		"@ai-sdk/openai-compatible": "^2.0.93",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"ai": "^6.0.331",
		"dotenv": "^17.3.1",
		"hono": "^4.13.18",
		"onnxruntime-web": "^1.27.0",
		"postgres": "^3.4.8",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@huggingface/transformers": "^4.2.0",
		"@opencode-ai/plugin": "^1.2.15",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	},
	"overrides": {
		"zod": "^4.6.6",
		"undici": "^8.12.4",
		"sharp": "^0.35.5",
		"adm-zip": "^0.6.1",
		"glob": "^14.0.6",
		"minimatch": "^11.0.8"
	}
}
