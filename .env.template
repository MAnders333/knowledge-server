# Knowledge Server Configuration
# Copy this to .env and fill in your values.
#
# OPTION A — Direct provider credentials (recommended; no proxy needed)
# Set the key(s) for the provider(s) you use. Per-provider credentials take
# precedence over the unified endpoint below.
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
#
# Optional: override the base URL for a provider (e.g. for Azure OpenAI, custom proxy)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Optional: token-limit parameter name for OpenAI-compatible chat calls.
# Newer OpenAI models (gpt-5.x, o-series) reject the legacy `max_tokens`
# parameter — set this to send `max_completion_tokens` instead.
# OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
#
# Optional: comma-separated request parameters to omit from OpenAI-compatible
# chat calls. gpt-5.x/o-series reasoning models also reject a non-default
# temperature (only the default 1 is accepted) — drop it from the request:
# OPENAI_DROP_PARAMS=temperature
#
# OPTION B — Unified proxy endpoint (backwards compatible)
# A single endpoint that routes all providers. Use this if you have a proxy
# that serves multiple providers under one URL.
#
# LLM_API_KEY=your-api-key-here
# LLM_BASE_ENDPOINT=https://your-llm-endpoint.example.com
#   Routes by model prefix: anthropic/→/anthropic/v1, google/→/gemini/v1beta, else /openai/v1

# LLM model slots — prefix determines provider and API format:
#   anthropic/... → Anthropic API
#   google/...    → Gemini API
#   openai/...    → OpenAI-compatible API
# LLM_EXTRACTION_MODEL=anthropic/claude-sonnet-4-6    # episode → knowledge extraction
# LLM_MERGE_MODEL=anthropic/claude-haiku-4-5          # near-duplicate merge (cheaper)
# LLM_CONTRADICTION_MODEL=anthropic/claude-haiku-4-5 # contradiction detection
# LLM_SYNTHESIS_MODEL=anthropic/claude-sonnet-4-6     # cross-session synthesis (defaults to LLM_EXTRACTION_MODEL)

# Per-attempt LLM timeouts in ms (a timed-out call is not retried).
# Precedence: LLM_TIMEOUT_<TYPE>_MS > LLM_TIMEOUT_MS > per-type default.
# Slow local models (Ollama) should raise the value for the affected call types.
# LLM_TIMEOUT_CONTRADICTION_MS=60000  # contradiction detection (default 60000)
# LLM_TIMEOUT_MERGE_MS=90000          # near-duplicate merge decisions (default 90000)
# LLM_TIMEOUT_EXTRACTION_MS=300000    # episode → knowledge extraction (default 300000)
# LLM_TIMEOUT_SYNTHESIS_MS=300000     # cross-session synthesis (default 300000)
# LLM_TIMEOUT_MS=300000               # fallback for any type without its own var (default: per-type defaults above)
# LLM_MAX_RETRIES=2                           # retries on transient LLM errors; a timed-out call is not retried

# Synthesis prompt cap (per cluster, per synthesis call)
# SYNTHESIS_MAX_PEERS=50              # max cluster members sent to the synthesis LLM, closest to centroid first
# SYNTHESIS_MAX_PROMPT_TOKENS=30000   # approx token budget for those members; furthest dropped first
# SYNTHESIS_MIN_NEW_MEMBERS=3         # re-synthesize a synthesized cluster after this many members joined...
# SYNTHESIS_MIN_NEW_FRACTION=0.2      # ...or this fraction (0..1) of its members, whichever comes first

# Embedding model
# All embedding APIs must be OpenAI-compatible (/v1/embeddings).
# Priority: EMBEDDING_BASE_URL → OPENAI_BASE_URL → LLM_BASE_ENDPOINT/openai/v1
#
# Changing EMBEDDING_MODEL triggers automatic re-embedding of all entries on the
# next startup or consolidation run (no manual intervention required).
#
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072  # truncated dimensions — only for text-embedding-3-* (Matryoshka); omit for all other models
# EMBEDDING_TIMEOUT_MS=20000  # per-request timeout; background re-embed/backfill uses at least 60000
# EMBEDDING_MAX_RETRIES=2     # retries per 100-text chunk on transient errors (background re-embed/backfill only)
#
# Example: local Ollama embeddings while using a cloud LLM:
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# (no EMBEDDING_API_KEY needed — Ollama does not require authentication)

# Server
# KNOWLEDGE_PORT=3179
# KNOWLEDGE_HOST=127.0.0.1
# KNOWLEDGE_ADMIN_TOKEN=your-stable-token-here       # optional; random per-process if unset
# KNOWLEDGE_ALLOWED_HOSTS=proxy.example.com:8443   # extra Host names the API accepts (comma-separated); for reverse proxies

# Logging. LOG_LEVEL=debug is the only level that logs query and entry text.
# LOG_LEVEL=info                              # debug | info | warn | error
# LOG_MAX_BYTES=20971520                      # rotate server.log at this size; keeps server.log.1-3; 0 disables rotation

# Redaction of credentials in transcript text (before staging, LLM and embedding calls, storage)
# REDACT_SECRETS=true                         # false disables

# Database paths
# Paths are read literally: ~ and $HOME are not expanded, so write absolute paths.
# KNOWLEDGE_DB_PATH=/absolute/path/to/knowledge.db
# OPENCODE_DB_PATH=/absolute/path/to/opencode.db
# STORE_INIT_TIMEOUT_MS=10000                 # bound on each knowledge store's connect at startup (default 10000)

# Multi-user support (shared knowledge DB)
# Set when multiple machines/users write to the same knowledge DB so each user's
# consolidation cursor advances independently. Defaults to the userId field in
# config.jsonc if set, otherwise the machine hostname.
# Also useful when the hostname is unstable (containers, ephemeral VMs, CI runners).
# KNOWLEDGE_USER_ID=alice       # per-person identifier
# KNOWLEDGE_USER_ID=ci-runner   # example for CI environments

# Source-specific overrides (auto-detected by default)
# CURSOR_DB_PATH=/path/to/state.vscdb
# CODEX_SESSIONS_DIR=/absolute/path/to/.codex/sessions
# VSCODE_DATA_DIR=/absolute/path/to/Library/Application Support/Code     # macOS
# VSCODE_DATA_DIR=/absolute/path/to/.config/Code                         # Linux

# Disable specific sources (all enabled by default)
# OPENCODE_ENABLED=false
# CLAUDE_ENABLED=false
# CURSOR_ENABLED=false
# CODEX_ENABLED=false
# VSCODE_ENABLED=false
# PI_ENABLED=false
# OMP_ENABLED=false
# PI_SESSIONS_ROOT=/absolute/path/to/.pi     # default ~/.pi (scans <root>/*/sessions)
# OMP_SESSIONS_ROOT=/absolute/path/to/.omp   # default ~/.omp (oh-my-pi)

# Daemon (knowledge-daemon uploads sessions; the server auto-spawns it unless told not to)
# DAEMON_AUTO_SPAWN=true                     # false: run knowledge-daemon yourself (launchd/systemd: knowledge-server setup-tool daemon)
# DAEMON_UPLOAD_INTERVAL_SECONDS=1800        # upload cycle length in seconds (default 1800); the daemon's --interval flag wins
# INITIAL_LOOKBACK_DAYS=30                   # a source's first run ingests sessions active in the last N days; 0 = all history

# Decay tuning
# DECAY_ARCHIVE_THRESHOLD=0.15
# DECAY_TOMBSTONE_DAYS=180
# DECAY_INTERVAL_MS=86400000   # strength decay + archiving runs daily, even with nothing pending (0 = disabled)

# Consolidation tuning
# CONSOLIDATION_CHUNK_SIZE=10
# CONSOLIDATION_MAX_SESSIONS=50
# CONSOLIDATION_MIN_MESSAGES=4
# RECONSOLIDATION_SIMILARITY_THRESHOLD=0.78          # near-duplicate merge cutoff; run `knowledge-server calibrate` to find the right value for your embedding model
# CONTRADICTION_MIN_SIMILARITY=0.4                   # lower bound of contradiction scan band; must be below RECONSOLIDATION_SIMILARITY_THRESHOLD
# CONTRADICTION_MAX_CANDIDATES=                    # most candidates checked per entry and scan path, highest similarity first (unset = no cap)
# CONTRADICTION_MIN_TOP_SIMILARITY=                  # skip an entry whose best candidate is below this similarity (unset = no floor)
# CONTRADICTION_CONFLICTS_ONLY=false                  # true: reply lists conflicts only (~65% fewer output tokens); recall unvalidated, enable after an online spot-check
# CONSOLIDATION_POLL_INTERVAL_MS=1800000             # auto-consolidate every 30 min while running (0 = disabled)
# CONSOLIDATION_INCLUDE_TOOL_OUTPUTS=atlassian_confluence_get_page,atlassian_confluence_search
#   Comma-separated tool names whose completed outputs are included in knowledge extraction.
#   Default: empty (no tool outputs). Add any MCP tool whose output contains knowledge worth encoding.

# Activation tuning
# ACTIVATION_MAX_RESULTS=10
# ACTIVATION_SIMILARITY_THRESHOLD=0.42

# Reranker (retrieve & re-rank: dense recall, then a precision stage). Enabled
# by default. RERANK_PROVIDER picks the stage:
#
#   local  (default) in-process cross-encoder. Runs offline after a one-time
#          ~23MB model download. Nothing leaves the machine.
#   remote (opt-in) one listwise call per activation to a decision model on the
#          LLM gateway (LLM_BASE_ENDPOINT / LLM_API_KEY above). PRIVACY: every
#          activation sends the query tail and the text of each candidate entry
#          (first RERANK_MAX_DOC_TOKENS tokens) to the gateway, which forwards it
#          to the model host. Retention terms are the gateway's and the host's.
#          Enable only if you accept that. Falls back to local if the gateway
#          settings are missing.
#
# RERANK_ENABLED=false                        # restore dense-only ordering
# RERANK_PROVIDER=local                       # local | remote (remote sends content off-machine)
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2  # local model; English only
# RERANK_MODELS_DIR=/absolute/path/to/models  # unset = ~/.local/share/knowledge-server/models (no ~ or $HOME expansion)
# RERANK_CANDIDATES=16                        # dense candidates scored per activation (remote max 40)
# RERANK_TIMEOUT_MS=3000                      # local: on expiry the whole batch uses dense ordering
# RERANK_MAX_QUERY_TOKENS=128                 # last N prompt tokens used as the query (remote: x4 chars)
# RERANK_MAX_DOC_TOKENS=256                   # first N tokens of each candidate (remote: x4 chars)
# RERANK_REMOTE_MODEL=clef                    # gateway decision model (remote only)
# RERANK_REMOTE_TIMEOUT_MS=4000               # remote: on expiry dense ordering is used
